# ==============================================================================
# SAKUCI PLAYGROUND - ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================
APP_NAME="Sakuci PHP & MySQL Ground"
APP_ENV=production
APP_KEY=base64:sakuci_secret_key_playground_12345
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

# ==============================================================================
# KONFIGURASI BASIS DATA (DATABASE)
# Pilihan: mysql (Direkomendasikan untuk aaPanel) | sqlite
# ==============================================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sakuci_ground
DB_USERNAME=root
DB_PASSWORD=

# Path Fallback SQLite (Hanya jika DB_CONNECTION=sqlite atau MySQL belum disiapkan)
DB_SQLITE_PATH="data/latihan.sqlite"
